<Application x:Class="GridMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GridMonitor.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="Background" Color="#0F172A" />
        <SolidColorBrush x:Key="Panel" Color="#1E293B" />
        <SolidColorBrush x:Key="PanelBorder" Color="#334155" />
        <SolidColorBrush x:Key="Text" Color="#E2E8F0" />
        <SolidColorBrush x:Key="Muted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />

        <conv:SparklineConverter x:Key="Sparkline" Width="260" Height="60" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:BreakerToBrushConverter x:Key="BreakerBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
