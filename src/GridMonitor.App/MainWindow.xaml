<Window x:Class="GridMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grid Monitor"
        Width="1400" Height="860"
        MinWidth="1000" MinHeight="600"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <DockPanel Margin="16">

        <!-- Header: title, live stats and start/stop -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start" Command="{Binding StartCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Grid Monitor" FontSize="22" FontWeight="Bold" Margin="0,0,28,0" />

                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="STATUS" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Value}" Foreground="{StaticResource Accent}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="READINGS / SEC" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding ReadingsPerSecond, StringFormat={}{0:F0}}" Style="{StaticResource Value}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="TOTAL LOAD" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding TotalLoadMva, StringFormat={}{0:F1} MVA}" Style="{StaticResource Value}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="ACTIVE ALARMS" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding ActiveAlarmCount}" Style="{StaticResource Value}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="LAST UPDATE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding LastUpdate.Value.LocalDateTime, StringFormat={}{0:HH:mm:ss.f}, FallbackValue=-}" Style="{StaticResource Value}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Alarm panel -->
        <Border DockPanel.Dock="Right" Width="400" Background="{StaticResource Panel}" CornerRadius="10" Padding="12" Margin="16,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearAlarmHistoryCommand}" Padding="10,3" />
                    <TextBlock Text="Alarm Log" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox ItemsSource="{Binding Alarms}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,6" Width="350">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
                                             Fill="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding FeederName, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                                        <TextBlock Style="{StaticResource Label}">
                                            <Run Text="{Binding RaisedAt.LocalDateTime, StringFormat={}{0:HH:mm:ss}, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Severity, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Feeder cards -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Feeders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Margin="0,0,16,16" Padding="16" CornerRadius="10"
                                Background="{StaticResource Panel}" BorderThickness="2"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#0F172A" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Substation}" Style="{StaticResource Label}" />
                                    </StackPanel>
                                </DockPanel>

                                <UniformGrid Columns="3" Margin="0,12,0,8">
                                    <StackPanel>
                                        <TextBlock Text="VOLTAGE" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding VoltageKv, StringFormat={}{0:F2} kV}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="CURRENT" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding CurrentA, StringFormat={}{0:F0} A}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="LOAD" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding LoadMva, StringFormat={}{0:F2} MVA}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Style="{StaticResource Label}">
                                    <Run Text="Loading " />
                                    <Run Text="{Binding LoadingPercent, StringFormat={}{0:F0}%, Mode=OneWay}" />
                                </TextBlock>
                                <ProgressBar Height="6" Margin="0,4,0,10" Minimum="0" Maximum="120"
                                             Value="{Binding LoadingPercent, Mode=OneWay}"
                                             Background="{StaticResource PanelBorder}" BorderThickness="0"
                                             Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />

                                <TextBlock Text="LOAD TREND (MVA)" Style="{StaticResource Label}" />
                                <Border Height="64" Margin="0,4,0,12" Background="#0F172A" CornerRadius="6" ClipToBounds="True">
                                    <Polyline Points="{Binding LoadHistory, Converter={StaticResource Sparkline}}"
                                              Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                                              Margin="2" />
                                </Border>

                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding ToggleLabel}"
                                            Command="{Binding ToggleBreakerCommand}" Margin="0" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3"
                                                   Fill="{Binding IsClosed, Converter={StaticResource BreakerBrush}}" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Run Text="Breaker " Foreground="{StaticResource Muted}" />
                                            <Run Text="{Binding Breaker, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text=" (sending…)" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCommandPending, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
